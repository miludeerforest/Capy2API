# Capy web-session bridge. Never commit .env or data/.
# Generate a key, e.g. python -c "import secrets; print(secrets.token_urlsafe(36))"
# Required: at least 32 characters; no anonymous inference/admin access.
CAPY_PROXY_KEY=

# Renewable Clerk session cookie, from an actual clerk.capy.ai request.
# Include the cookie name: __client=<value>. Do not use a public capy_ API key.
# Alternatively ingest with authenticated POST /admin/ingest.
# Cookie validity depends on Clerk session expiry/revocation; not permanent.
CAPY_COOKIE=
CAPY_CLERK_SESSION_ID=
# Short-lived JWT for diagnostics only; expiry does not renew without a cookie.
CAPY_BEARER=

# Empty org selects the first organization; default project must belong to it.
CAPY_ORG_ID=
CAPY_PROJECT_ID=

# Mandatory safety boundary: 0 disables inference, not free-model filtering.
CAPY_ONLY_FREE=1
# Delete only threads created by this bridge; failure logs include the jam ID.
CAPY_DELETE_AFTER=1
CAPY_TURN_TIMEOUT=240
CAPY_POLL_INTERVAL=1.0
# Realtime uses the verified Capy websocket; 0 keeps REST-only operation.
CAPY_REALTIME=1
# Periodic REST reconciliation while the websocket is connected.
CAPY_RECONCILE_INTERVAL=3
# SSE comments maintain transport liveness; they are not generated tokens.
CAPY_HEARTBEAT_INTERVAL=5
# Empty uses the model's default effort. Unsupported standard efforts clamp
# to its nearest advertised level; upstream adherence is not guaranteed.
CAPY_REASONING=
CAPY_STATE_PATH=/data/state.json
